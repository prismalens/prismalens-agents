{
	"name": "prismalens-agents",
	"version": "0.0.1",
	"description": "AI investigation orchestrator — root cause analysis for production incidents",
	"type": "module",
	"bin": {
		"pl": "./dist/bin/pl.js"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsx bin/pl.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"test": "vitest run src/__tests__/unit",
		"test:integration": "vitest run src/__tests__/integration",
		"test:all": "vitest run",
		"test:watch": "vitest src/__tests__/unit",
		"prepublishOnly": "pnpm build"
	},
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"investigation",
		"incident",
		"root-cause",
		"sre",
		"observability",
		"ai-agent"
	],
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/prismalens/prismalens-agents.git"
	},
	"packageManager": "pnpm@10.26.2",
	"dependencies": {
		"chokidar": "^5.0.0",
		"citty": "^0.2.1",
		"consola": "^3.4.2",
		"pino": "^10.3.1",
		"tinyexec": "^1.0.4",
		"yaml": "^2.8.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@types/node": "^25.5.0",
		"@vitest/coverage-v8": "^4.1.0",
		"pino-pretty": "^13.1.3",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0"
	}
}
